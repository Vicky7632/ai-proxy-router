FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN python -c "from pathlib import Path; p = Path('requirements.txt'); p.write_text('\n'.join(line for line in p.read_text(encoding='utf-16').splitlines() if not line.lower().startswith('pywin32==')) + '\n', encoding='utf-8')" \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY alembic ./alembic
COPY alembic.ini .

RUN useradd --system --create-home appuser
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
